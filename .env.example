# URL base da API do backend Mobogo (ex: http://localhost:8000/api ou https://api.mobogo.com/api)
VITE_API_URL=http://localhost:8000/api

# Porta HTTP exposta no host quando executado via Docker Compose (Padrão: 3333)
PORT=3333
